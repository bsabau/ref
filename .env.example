# Copy to .env.local and fill in.
DATABASE_URL=postgres://...
SESSION_SECRET=
CRON_SECRET=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Optional: setlist.fm API key for scripts/fetch-setlists.mjs
